---
// /revista — o ARQUIVO: as três edições na estante, com a capa real (Flipsnack), data, páginas, a
// linha de cada uma e o link para ler a edição inteira no Flipsnack.
import Botao from '../components/base/Botao.astro';
import Pagina from '../components/edicao/Pagina.astro';
import CabecaPagina from '../components/paginas/CabecaPagina.astro';
import Poster from '../components/base/Poster.astro';
import { alt } from '../content/textos/midia.ts';
import { doisDigitos } from '../components/secoes/util.ts';
import { contato } from '../config/contato.ts';
import { revista as r } from '../content/textos/paginas.ts';
import Interna from '../layouts/Interna.astro';

const edicoes = r.edicoes.map((e, i) => ({ ...e, numero: doisDigitos(i + 1) }));
---

<Interna
  titulo={r.meta.title}
  descricao={r.meta.description}
  trilha={[{ nome: 'A revista', url: '/revista' }]}
>
  <CabecaPagina secao="Arquivo" rotulo={r.rotulo} titulo={r.titulo} resposta={r.resposta} />

  <Pagina tom="capa" secao="As edições" rotulo="As três edições">
    <ol class="estante" role="list">
      {edicoes.map((e) => (
        <li class="estante__item">
          <a class="estante__capa" href={e.link} rel="noopener" target="_blank">
            <Poster
              imagem={e.capa}
              alt={alt[e.capa] ?? ''}
              sizes="(min-width: 48rem) 30vw, 90vw"
              proporcao="3 / 4"
            />
            <span class="sr-only"> (abre a edição no Flipsnack, em nova aba)</span>
          </a>
          <p class="estante__num versalete">
            Edição {e.numero} · {e.data} · {e.paginas} páginas
          </p>
          <h2 id={`ed-${e.numero}`} class="estante__nome">
            {e.nome}
          </h2>
          <p class="estante__linha">{e.linha}</p>
          <a class="estante__link versalete" href={e.link} rel="noopener" target="_blank">
            {r.botao}
            <span aria-hidden="true">↗</span>
            <span class="sr-only"> (Flipsnack, abre em nova aba)</span>
          </a>
        </li>
      ))}
    </ol>
  </Pagina>

  <Pagina tom="pagina" secao="Próxima edição" rotulo="Próxima edição">
    <div class="prox">
      <p class="prox__num numeros" aria-hidden="true">
        Nº 10
      </p>
      <div>
        <h2>
          Este site é a <em>edição</em> dos 10 anos
        </h2>
        <p class="lead">
          Em 2027 a Todalinda completa dez anos no Centro de Lages. Enquanto a próxima revista não
          chega, o dia a dia da casa sai no Instagram.
        </p>
        <Botao href={contato.instagram.valor.url} externo variante="secundario">
          Instagram @{contato.instagram.valor.usuario}
        </Botao>
      </div>
    </div>
  </Pagina>
</Interna>

<style>
  .estante {
    display: grid;
    gap: var(--e-7);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: var(--largura-max);
  }
  @media (min-width: 48rem) {
    .estante {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--e-6);
    }
  }
  .estante__capa {
    display: block;
    border: var(--fio) solid var(--fio-cor);
    box-shadow: 0 1.2rem 2.4rem -1.2rem color-mix(in srgb, var(--cor-noite) 80%, transparent);
    transition: translate 0.4s var(--ease, ease);
  }
  .estante__capa:hover {
    translate: 0 -4px;
  }
  .estante__capa:focus-visible {
    outline: 2px solid var(--cor-ouro-claro);
    outline-offset: 4px;
  }
  .estante__num {
    margin: var(--e-4) 0 var(--e-2);
    color: var(--cor-ouro);
  }
  .estante__nome {
    font-size: var(--fs-h3);
    font-style: italic;
    font-weight: 700;
  }
  .estante__linha {
    margin: var(--e-3) 0 var(--e-2);
    color: var(--texto-2);
  }
  .estante__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--cor-ouro-claro);
    text-underline-offset: 0.25em;
  }
  @media (prefers-reduced-motion: reduce) {
    .estante__capa {
      transition: none;
    }
  }
  .prox {
    display: grid;
    gap: var(--e-5);
    max-width: var(--largura-max);
    align-items: center;
  }
  .prox__num {
    margin: 0;
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-weight: 800;
    font-size: clamp(5rem, 3rem + 8vw, 11rem);
    line-height: 0.85;
    color: var(--cor-mocha);
  }
  .prox h2 {
    margin-bottom: var(--e-4);
  }
  @media (min-width: 60rem) {
    .prox {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--e-8);
    }
  }
</style>
