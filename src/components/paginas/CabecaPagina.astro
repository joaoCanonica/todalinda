---
// Abertura de página interna: etiqueta (hashtag real) ou rótulo, manchete com uma palavra em itálico
// pesado, e o parágrafo-resposta com capitular (como a abertura das matérias da revista).
import Rotulo from '../base/Rotulo.astro';
import Capitular from '../edicao/Capitular.astro';
import Etiqueta from '../edicao/Etiqueta.astro';
import Pagina from '../edicao/Pagina.astro';

interface Props {
  secao: string;
  rotulo?: string;
  hashtag?: '#TalentoTodalinda' | '#MomentoTodalinda' | '#EquipeTodalinda' | '#TodaMake';
  titulo: { antes: string; destaque: string; depois: string };
  resposta: string;
  tom?: 'capa' | 'pagina';
  capitular?: boolean;
}
const { secao, rotulo, hashtag, titulo, resposta, tom = 'capa', capitular = true } = Astro.props;
---

<Pagina tom={tom} secao={secao} class="cabeca-pagina">
  <div class="cp">
    <div class="cp__marca">
      {hashtag && <Etiqueta hashtag={hashtag} />}
      {rotulo && <Rotulo tom="acento">{rotulo}</Rotulo>}
    </div>
    <h1 class="cp__titulo">
      {titulo.antes}
      <em>{titulo.destaque}</em>
      {titulo.depois}
    </h1>
    {capitular ? (
      <Capitular>
        <p class="lead cp__resposta">{resposta}</p>
      </Capitular>
    ) : (
      <p class="lead cp__resposta">{resposta}</p>
    )}
    <slot />
  </div>
</Pagina>

<style>
  .cp {
    max-width: var(--largura-max);
  }
  .cp__marca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
    margin-bottom: var(--e-5);
  }
  .cp__marca :global(p) {
    margin: 0;
  }
  .cp__titulo {
    font-size: clamp(2.9rem, 1.4rem + 6vw, 7.5rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
    max-width: 16ch;
  }
  .cp__resposta {
    margin-top: var(--e-6);
  }
  :global(.cabeca-pagina) {
    padding-block: var(--e-8) var(--e-8);
  }
</style>
