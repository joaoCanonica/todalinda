---
// 11 · A REVISTA (capa): as 3 edições com a capa real (imagem pública do Flipsnack) e o link para ler.
import { paginas } from '../../content/textos/index.ts';
import { revista as r } from '../../content/textos/home.ts';
import Rotulo from '../base/Rotulo.astro';
import Pagina from '../edicao/Pagina.astro';
import Poster from '../base/Poster.astro';
import { alt } from '../../content/textos/midia.ts';

const edicoes = paginas.revista.edicoes;
---

<Pagina tom="capa" secao={r.folio} id="revista" rotulo="A revista">
  <Rotulo tom="acento">{r.folio}</Rotulo>
  <h2>
    {r.titulo.antes}
    <em>{r.titulo.destaque}</em>
    {r.titulo.depois}
  </h2>
  <p class="rev__intro">{r.intro}</p>
  <ul class="rev" role="list">
    {edicoes.map((e) => (
      <li class="rev__item" data-revelar>
        <a class="rev__capa" href={e.link} rel="noopener" target="_blank">
          <Poster
            imagem={e.capa}
            alt={alt[e.capa] ?? ''}
            sizes="(min-width: 60rem) 25vw, 80vw"
            proporcao="3 / 4"
          />
          <span class="sr-only"> (abre a edição no Flipsnack, em nova aba)</span>
        </a>
        <p class="rev__data versalete">
          {e.data} · {e.paginas} páginas
        </p>
        <h3 class="rev__nome">{e.nome}</h3>
        <p class="rev__linha">{e.linha}</p>
        <a class="rev__link versalete" href={e.link} rel="noopener" target="_blank">
          Ler a edição <span aria-hidden="true">↗</span>
          <span class="sr-only"> (Flipsnack, abre em nova aba)</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="rev__todas">
    <a class="versalete" href="/revista">
      Ver o arquivo da revista
    </a>
  </p>
</Pagina>

<style>
  .rev__intro {
    margin-top: var(--e-4);
    color: var(--texto-2);
  }
  .rev {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--e-6);
    margin: var(--e-6) 0 0;
    padding: 0;
    list-style: none;
    max-width: var(--largura-max);
  }
  .rev__capa {
    display: block;
    border: var(--fio) solid var(--fio-cor);
    box-shadow: 0 1.2rem 2.4rem -1.2rem color-mix(in srgb, #000 80%, transparent);
    transition: translate 0.4s ease;
  }
  .rev__capa:hover {
    translate: 0 -4px;
  }
  .rev__capa:focus-visible {
    outline: 2px solid var(--cor-ouro-claro);
    outline-offset: 4px;
  }
  .rev__data {
    margin: var(--e-4) 0 var(--e-2);
    color: var(--cor-ouro);
  }
  .rev__nome {
    font-size: var(--fs-h3);
    font-style: italic;
    font-weight: 700;
  }
  .rev__linha {
    margin: var(--e-3) 0 var(--e-2);
    color: var(--texto-2);
    font-size: var(--fs-pequeno);
  }
  .rev__link,
  .rev__todas a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--cor-ouro-claro);
    text-underline-offset: 0.25em;
  }
  .rev__todas {
    margin-top: var(--e-6);
  }
  @media (prefers-reduced-motion: reduce) {
    .rev__capa {
      transition: none;
    }
  }
</style>
