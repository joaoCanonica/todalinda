---
// Tabela de horário da semana, com "hoje" destacado (script compartilhado com o StatusHorario).
import { horario } from '../../config/horario.ts';
import Provisorio from '../Provisorio.astro';

const NOMES = ['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'];
const ordem = [2, 3, 4, 5, 6, 0, 1]; // a semana da casa começa na terça
const fmt = (hhmm: string) => {
  const [h, m] = hhmm.split(':').map(Number);
  return m ? `${h}h${String(m).padStart(2, '0')}` : `${h}h`;
};
---

<table class="tabela-horario" data-tabela-horario>
  <caption class="sr-only">Horário de funcionamento</caption>
  <tbody>
    {ordem.map((d) => {
      const t = horario.semana.valor[d];
      return (
        <tr data-dia={d}>
          <th scope="row">{NOMES[d]}</th>
          <td>{t ? `${fmt(t.abre)} – ${fmt(t.fecha)}` : 'Fechado'}</td>
        </tr>
      );
    })}
  </tbody>
</table>
<p class="tabela-horario__nota">
  <Provisorio
    motivo={horario.fechaNosFeriados.estado === 'aviso' ? horario.fechaNosFeriados.motivo : ''}
  >
    Feriados: fechado.
  </Provisorio>
</p>

<script>
  import '../../scripts/horario-vivo.ts';
</script>

<style>
  .tabela-horario {
    width: 100%;
    max-width: 24rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 0.55em 0;
    border-bottom: var(--fio) solid var(--fio-cor);
    text-align: left;
    font-weight: 400;
  }
  td {
    text-align: right;
  }
  tr.hoje th,
  tr.hoje td {
    font-weight: 700;
    color: var(--acento-forte);
  }
  tr.hoje th::after {
    content: ' · hoje';
    font-family: var(--fonte-texto);
    font-size: var(--fs-versalete);
    letter-spacing: var(--espaco-versalete);
    text-transform: uppercase;
    color: var(--acento);
  }
  .tabela-horario__nota {
    margin-top: var(--e-3);
    font-size: var(--fs-pequeno);
    color: var(--texto-2);
  }
</style>
