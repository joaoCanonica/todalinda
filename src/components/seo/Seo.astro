---
// <head> de SEO de todas as páginas (sessão 8): título, descrição, robots, canonical, Open Graph,
// Twitter. O JSON-LD vai no fim do <body> (JsonLd.astro). Sem domínio definitivo (PUBLIC_SITE_URL) não há canonical nem og:url absolutos:
// o preview segue noindex e o audit-seo avisa.
import { robotsMeta, seo } from '../../config/seo.ts';
import { valorDe } from '../../config/tipos.ts';
import { abs } from './jsonld.ts';

interface Props {
  titulo: string;
  descricao: string;
  /** Imagem Open Graph (1200×630) gerada no build: public/og/<nome>.jpg. */
  og?: string;
  tipo?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}
const { titulo, descricao, og = 'capa', tipo = 'website', noindex = false } = Astro.props;
const site = valorDe(seo.siteUrl);
const caminho = Astro.url.pathname.replace(/index\.html$/, '');
const canonical = site ? `${site}${caminho === '/' ? '/' : caminho.replace(/\/?$/, '')}` : null;
const imagem = abs(`/og/${og}.jpg`);
// páginas internas de revisão (/_estilo, /_capa-a…) nunca entram no índice
const interna = /^\/_/.test(Astro.url.pathname);
const robots = noindex || interna ? 'noindex, nofollow' : robotsMeta();
---

<title>{titulo}</title>
<meta name="description" content={descricao} />
<meta name="robots" content={robots} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="Todalinda" />
<meta property="og:type" content={tipo} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descricao} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imagem} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Todalinda, salão de beleza no Centro de Lages/SC, desde 2017"
/>
<meta name="twitter:card" content="summary_large_image" />
