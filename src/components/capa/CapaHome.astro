---
// A capa da home (hero). Pôster AVIF no HTML desde o início (é o LCP); o loop entra por cima.
// Variante "a": loop "ondas" · "b": loop "iluminada" (para comparação).
import { contato } from '../../config/contato.ts';
import { marca } from '../../config/marca.ts';
import { video } from '../../lib/midia.ts';
import { linkWhatsApp, MENSAGENS } from '../../lib/whatsapp.ts';
import Botao from '../base/Botao.astro';
import StatusHorario from '../base/StatusHorario.astro';
import Logo from '../marca/Logo.astro';

interface Props {
  variante?: 'a' | 'b';
}
const { variante = 'a' } = Astro.props;
const trecho = variante === 'a' ? 'ondas' : 'iluminada';
const grande = video('v-filme', trecho, '720x900-4x5');
const pequeno = video('v-filme', trecho, '544x680-4x5');
const alt =
  variante === 'a'
    ? 'No salão, a profissional ajeita as ondas escuras com reflexo de uma cliente sorridente.'
    : 'Cliente com morena iluminada mel, sorrindo, enquanto a profissional ajeita o cabelo.';
const e = contato.endereco.valor;
const faixa = [
  'Nº 10',
  `desde ${marca.fundacao.ano.valor}`,
  `${e.logradouro}, ${e.numero}`,
  `${e.cidade}/${e.uf}`,
];
const chamadas = [
  { texto: 'Morena iluminada, loiros e ruivos: técnica + cor', href: '/trabalhos' },
  { texto: 'Dois Reais ou um Cabelo: o quadro da casa', href: '/dois-reais-ou-um-cabelo' },
  { texto: 'Por dentro da casa, em 3D', href: '/a-casa' },
];
---

<header class="capa-home tom-capa" data-capa>
  <div class="capa-home__texto">
    <div class="capa-home__cabecalho">
      <a href="/" class="capa-home__logo" data-capa-logo aria-label="Todalinda, início">
        <Logo variante="palavra" titulo="" />
      </a>
      <p class="capa-home__faixa versalete">
        {faixa.map((f, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span>{f}</span>
          </>
        ))}
      </p>
    </div>

    <h1 class="capa-home__manchete" data-capa-entra>
      Cor, corte e cuidado com quem entende de <em>fio</em>.
    </h1>

    <ul class="capa-home__chamadas" role="list" data-capa-entra>
      {chamadas.map((c, i) => (
        <li>
          <a href={c.href}>
            <span class="capa-home__num numeros" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span>{c.texto}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="capa-home__acoes" data-capa-entra>
      <Botao href={linkWhatsApp(MENSAGENS.geral())} externo>
        Agendar horário
      </Botao>
      <Botao href="/trabalhos" variante="secundario">
        Ver trabalhos
      </Botao>
    </div>

    <div class="capa-home__rodape" data-capa-entra>
      <StatusHorario />
    </div>
  </div>

  <div class="capa-home__midia" data-capa-midia>
    <picture>
      <img
        class="capa-home__poster"
        src={grande.poster}
        srcset={`${pequeno.poster} 544w, ${grande.poster} 720w`}
        sizes="(min-width: 60rem) 42vw, 100vw"
        width={grande.w}
        height={grande.h}
        alt={alt}
        fetchpriority="high"
        decoding="async"
        data-capa-poster
      />
    </picture>
    <video
      class="capa-home__video"
      muted
      loop
      playsinline
      preload="none"
      poster={grande.poster}
      width={grande.w}
      height={grande.h}
      aria-hidden="true"
      data-capa-video
    >
      <source media="(max-width: 40rem)" src={pequeno.webm} type="video/webm" />
      <source media="(max-width: 40rem)" src={pequeno.mp4} type="video/mp4" />
      <source src={grande.webm} type="video/webm" />
      <source src={grande.mp4} type="video/mp4" />
    </video>
    <button class="capa-home__pausa versalete" type="button" data-capa-pausa hidden>
      <span data-capa-pausa-texto>Pausar vídeo</span>
    </button>
  </div>
</header>

<script>
  import './capa.ts';
</script>

<style>
  .capa-home {
    display: grid;
    gap: var(--e-6);
    padding: var(--e-4) var(--margem) var(--e-7);
  }
  .capa-home__texto {
    display: flex;
    flex-direction: column;
    gap: var(--e-6);
    min-width: 0;
  }
  .capa-home__cabecalho {
    display: grid;
    gap: var(--e-3);
  }
  .capa-home__logo {
    display: block;
    color: var(--cor-papel);
  }
  .capa-home__faixa {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15em 0.75em;
    max-width: none;
    margin: 0;
    padding-block: 0.55em;
    border-block: var(--fio) solid var(--fio-cor);
    color: var(--acento);
  }
  .capa-home__manchete {
    font-size: clamp(3.25rem, 1.5rem + 5.6vw, 6.75rem);
    line-height: 0.93;
    letter-spacing: -0.025em;
    font-weight: 500;
  }
  .capa-home__chamadas {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 32rem;
  }
  .capa-home__chamadas a {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    align-items: baseline;
    min-height: 44px;
    padding-block: 0.7em;
    border-top: var(--fio) solid var(--fio-cor);
    color: var(--cor-papel);
    font-size: var(--fs-lead);
    line-height: 1.3;
    text-decoration: none;
  }
  .capa-home__chamadas li:last-child a {
    border-bottom: var(--fio) solid var(--fio-cor);
  }
  .capa-home__chamadas a:hover span:last-child {
    text-decoration: underline;
    text-decoration-thickness: var(--fio);
    text-underline-offset: 0.22em;
  }
  .capa-home__num {
    color: var(--acento);
    font-size: var(--fs-pequeno);
  }
  .capa-home__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3) var(--e-5);
  }
  .capa-home__rodape {
    padding-top: var(--e-3);
  }

  /* a mídia: mobile sangra (borda a borda) logo abaixo do cabeçalho */
  .capa-home__midia {
    position: relative;
    order: 0;
    aspect-ratio: 4 / 5;
    margin-inline: calc(var(--margem) * -1);
    background: var(--cor-cafe);
    overflow: hidden;
  }
  .capa-home__poster,
  .capa-home__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* o vídeo nasce com o mesmo pôster (é o LCP desde o início); o 1º quadro do loop não gera LCP novo */
  .capa-home__video {
    background: transparent;
  }
  .capa-home__pausa {
    position: absolute;
    inset-block-end: var(--e-3);
    inset-inline-end: var(--e-3);
    min-height: 44px;
    padding: 0 1em;
    border: var(--fio) solid color-mix(in srgb, var(--cor-papel) 60%, transparent);
    background: color-mix(in srgb, var(--cor-noite) 70%, transparent);
    color: var(--cor-papel);
    cursor: pointer;
  }
  .capa-home__pausa[hidden] {
    display: none;
  }

  @media (max-width: 59.99rem) {
    /* no celular a mídia entra entre o cabeçalho e a manchete */
    .capa-home {
      display: flex;
      flex-direction: column;
    }
    .capa-home__texto {
      display: contents;
    }
    .capa-home__cabecalho {
      order: 1;
    }
    .capa-home__midia {
      order: 2;
    }
    .capa-home__manchete {
      order: 3;
    }
    .capa-home__chamadas {
      order: 4;
    }
    .capa-home__acoes {
      order: 5;
    }
    .capa-home__rodape {
      order: 6;
    }
  }

  @media (min-width: 60rem) {
    .capa-home {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: stretch;
      min-height: 100svh;
      padding-block: var(--e-5);
      gap: var(--e-7);
    }
    .capa-home__texto {
      justify-content: space-between;
      gap: var(--e-5);
    }
    .capa-home__midia {
      margin-inline: 0;
      height: calc(100svh - var(--e-5) * 2);
      max-height: 56rem;
      min-height: 34rem;
      aspect-ratio: 4 / 5;
    }
  }
</style>
