{
  "name": "todalinda-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Site da Todalinda (Ateliê de Beleza Toda Linda), Lages/SC.",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.28.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "predev": "node scripts/prepare-media.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare-media.mjs && node scripts/validate-config.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && eslint . && prettier --check .",
    "test": "vitest run",
    "test:e2e": "node tests-e2e/agendar.e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate-config": "node scripts/validate-config.mjs",
    "audit-compliance": "node scripts/audit-compliance.mjs",
    "audit-a11y": "node scripts/pendente.mjs audit-a11y 9",
    "audit-lighthouse": "node scripts/pendente.mjs audit-lighthouse 9",
    "audit-seo": "node scripts/pendente.mjs audit-seo 8",
    "audit-contraste": "node scripts/audit-contraste.mjs",
    "audit-pesos": "node scripts/pendente.mjs audit-pesos 9",
    "media:prepare": "node scripts/prepare-media.mjs",
    "model:prepare": "node scripts/model-prepare.mjs",
    "capturar": "node scripts/capturar.mjs",
    "media:manifesto": "node scripts/gerar-manifesto.mjs",
    "media:quadros": "node scripts/extract-stills.mjs --folhas",
    "media:transcrever": "node scripts/transcrever.mjs",
    "postbuild": "node scripts/audit-compliance.mjs"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "astro": "7.4.12",
    "sharp": "0.35.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource/prata": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/three": "0.187.0",
    "ajv": "^8.20.0",
    "astro-eslint-parser": "3.2.0",
    "draco3dgltf": "1.5.9",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "meshoptimizer": "1.3.0",
    "playwright": "1.63.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "qrcode": "1.5.4",
    "svgo": "4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
